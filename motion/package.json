{
  "name": "stickman-motion-canvas",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:audio": "python3 ../scripts/prepare_audio.py",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:action": "node scripts/test-action.mjs",
    "render": "node scripts/render.mjs",
    "format": "prettier --write src scripts tests *.json *.html *.ts",
    "format:check": "prettier --check src scripts tests *.json *.html *.ts",
    "test:newton": "node scripts/test-newton.mjs",
    "test:series": "node scripts/test-series.mjs",
    "render:series": "node scripts/render-series.mjs"
  },
  "dependencies": {
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2"
  },
  "devDependencies": {
    "@motion-canvas/ui": "3.17.2",
    "@motion-canvas/vite-plugin": "3.17.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
