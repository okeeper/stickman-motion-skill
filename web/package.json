{
  "name": "stickman-motion-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "render": "node scripts/render.mjs",
    "format": "prettier --write src scripts tests *.json *.html *.ts",
    "format:check": "prettier --check src scripts tests *.json *.html *.ts"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
